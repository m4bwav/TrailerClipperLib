<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net48 runs the library's netstandard2.0 build (Windows only); net10.0 runs the net10.0 build everywhere. -->
    <!-- Both targets on every OS, so one packages.lock.json serves the whole matrix; CI runs net48 on Windows only. -->
    <TargetFrameworks>net10.0;net48</TargetFrameworks>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- A locked-mode lock file must not depend on what the SDK infers per OS (the NuGet reference's trap). -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/TrailerClipperLib/TrailerClipperLib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="PublicApi-1.1.0.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Golden/1.1.0.json" Link="Golden/1.1.0.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Golden/fixtures/*" Link="Golden/fixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
